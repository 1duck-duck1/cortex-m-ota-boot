# 统一换行符策略：仓库内一律使用 LF，避免 Windows 协作时产生整文件 diff
* text=auto eol=lf

# 二进制文件不做换行符转换
*.bin  binary
*.hex  binary
*.elf  binary
*.axf  binary
*.a    binary
*.o    binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.7z   binary
*.exe  binary

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 让 GitHub 正确识别文档类型
*.md   diff=markdown